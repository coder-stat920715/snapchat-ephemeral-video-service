    {
      "name": "4. Manual - 5 minute TTL fallback",
      "item": [
        {
          "name": "F1. Upload request (VIEW_ONCE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('fb_videoId', b.videoId);",
                  "pm.collectionVariables.set('fb_uploadUrl', b.presignedUploadUrl);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/videos/upload-request",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{ownerId}}\",\n  \"title\": \"fallback ttl test\",\n  \"durationSeconds\": 5,\n  \"retentionType\": \"VIEW_ONCE_5MIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "F2. Upload bytes to S3",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
