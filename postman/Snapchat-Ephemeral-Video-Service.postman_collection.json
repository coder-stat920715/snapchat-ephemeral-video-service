{
  "info": {
    "name": "Snapchat Ephemeral Video Service",
    "description": "End-to-end tests for the ephemeral video backend. Run folders in order with the Collection Runner (delay 3000 ms). Edit baseUrl / ownerId / viewerId in Collection > Variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "ownerId",
      "value": "alice"
    },
    {
      "key": "viewerId",
      "value": "bob"
    },
    {
      "key": "vo_videoId",
      "value": ""
    },
    {
      "key": "vo_uploadUrl",
      "value": ""
    },
    {
      "key": "vo_playbackToken",
      "value": ""
    },
    {
      "key": "vo_signedUrl",
      "value": ""
    },
    {
      "key": "st_videoId",
      "value": ""
    },
    {
      "key": "st_uploadUrl",
      "value": ""
    },
    {
      "key": "st_playbackToken",
      "value": ""
    },
    {
      "key": "st_signedUrl",
      "value": ""
    },
    {
      "key": "neg_videoId",
      "value": ""
    },
    {
      "key": "fb_videoId",
      "value": ""
    },
    {
      "key": "fb_uploadUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Actuator health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "description": ""
          }
        }
      ]
    },
    {
      "name": "1. VIEW_ONCE_5MIN happy path",
      "item": [
        {
          "name": "1. Upload request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('videoId + presigned URL returned', () => {",
                  "  pm.expect(b.videoId).to.be.a('string');",
                  "  pm.expect(b.presignedUploadUrl).to.include('X-Amz-Signature');",
                  "  pm.expect(b.expiresAt).to.be.a('string');",
                  "});",
                  "pm.test('URL expires in ~5 minutes', () => {",
                  "  const s = (new Date(b.expiresAt) - Date.now()) / 1000;",
                  "  pm.expect(s).to.be.within(240, 310);",
                  "});",
                  "pm.collectionVariables.set('vo_videoId', b.videoId);",
                  "pm.collectionVariables.set('vo_uploadUrl', b.presignedUploadUrl);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/videos/upload-request",
            "description": "Creates a PENDING row and returns a 5-minute presigned S3 PUT URL.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{ownerId}}\",\n  \"title\": \"1. VIEW_ONCE_5MIN happy path\",\n  \"durationSeconds\": 8,\n  \"retentionType\": \"VIEW_ONCE_5MIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. Upload bytes directly to S3 (presigned PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('S3 accepted the upload (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "video/mp4"
              }
            ],
            "url": "{{vo_uploadUrl}}",
            "description": "Goes straight to S3/LocalStack, NOT the Spring Boot app. Content-Type MUST be video/mp4 (it is part of the signature). To upload a real file: Body > binary > select file.",
            "body": {
              "mode": "raw",
              "raw": "ephemeral-test-video-bytes",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            }
          }
        },
        {
          "name": "3. Confirm upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('status is READY', () => pm.expect(b.status).to.eql('READY'));",
                  "pm.test('retention clock started (VIEW_ONCE_5MIN)', () => {",
                  "  const s = (new Date(b.expiresAt) - Date.now()) / 1000;",
                  "  pm.expect(s).to.be.within(240, 310);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/videos/{{vo_videoId}}/confirm",
            "description": "Backend HEADs the S3 object, flips PENDING -> READY and starts the TTL clock."
          }
        },
        {
          "name": "4. Confirm again (idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK again', () => pm.response.to.have.status(200));",
                  "pm.test('still READY', () => pm.expect(pm.response.json().status).to.eql('READY'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/videos/{{vo_videoId}}/confirm",
            "description": ""
          }
        },
        {
          "name": "5. Request play token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('token + signed URL returned', () => {",
                  "  pm.expect(b.playbackToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(b.cloudfrontSignedUrl).to.match(/^https?:\\/\\//);",
                  "});",
                  "pm.collectionVariables.set('vo_playbackToken', b.playbackToken);",
                  "pm.collectionVariables.set('vo_signedUrl', b.cloudfrontSignedUrl);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/videos/{{vo_videoId}}/play-token",
            "description": "Stores a single-use token in Redis (key video:token:{videoId}, TTL 90s) and returns a 60s signed URL (CloudFront in prod, S3 presigned GET locally).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{viewerId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "6. Second play token while session active (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('message mentions active session', () => pm.expect(pm.response.json().message).to.include('already active'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/videos/{{vo_videoId}}/play-token",
            "description": "VIEW_ONCE uses Redis SET NX, so only one live token can exist.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{viewerId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "7. Play video via signed URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('bytes match what was uploaded', () => pm.expect(pm.response.text()).to.eql('ephemeral-test-video-bytes'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{vo_signedUrl}}",
            "description": "Simulates the player. If you get 403 SignatureDoesNotMatch in Postman, use curl -L \"<signedUrl>\" (see guide)."
          }
        },
        {
          "name": "8. Complete with WRONG token (expect 410)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('410 Gone', () => pm.response.to.have.status(410));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/videos/{{vo_videoId}}/complete",
            "description": "A wrong token must not burn the real one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playbackToken\": \"not-a-real-token\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "9. Complete with correct token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('action = HARD_DELETE_SCHEDULED', () => pm.expect(pm.response.json().action).to.eql('HARD_DELETE_SCHEDULED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/videos/{{vo_videoId}}/complete",
            "description": "Atomically burns the token via Lua. VIEW_ONCE: row -> EXPIRED and async hard delete from S3. STORE_24HR: soft delete (object tagged playback-completed=true, kept until 24h).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playbackToken\": \"{{vo_playbackToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "10. Complete again with same token (expect 410)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('410 Gone - token already burned', () => pm.response.to.have.status(410));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/videos/{{vo_videoId}}/complete",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playbackToken\": \"{{vo_playbackToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "11. Play token after completion (expect 410)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('410 Gone - video no longer available', () => pm.response.to.have.status(410));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/videos/{{vo_videoId}}/play-token",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{viewerId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "12. Old signed URL after async delete (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 - object deleted from S3', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{vo_signedUrl}}",
            "description": "Async delete normally finishes in <1s. Run with >= 3s delay (Runner) or wait a moment before sending."
          }
        }
      ]
    },
